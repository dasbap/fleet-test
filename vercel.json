{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "e-samba.com"
        }
      ],
      "destination": "https://www.e-samba.com/:path*",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "https://marketing.e-samba.com/guides",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "https://marketing.e-samba.com/guides",
      "permanent": true
    },
    {
      "source": "/tarifs",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/tarifs/",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/guides/:path*",
      "destination": "https://marketing.e-samba.com/guides/:path*",
      "permanent": true
    },
    {
      "source": "/fonctionnalites/:path*",
      "destination": "https://marketing.e-samba.com/fonctionnalites/:path*",
      "permanent": true
    },
    {
      "source": "/solutions/:path*",
      "destination": "https://marketing.e-samba.com/solutions/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ressources/seo-ia/modeles/:path*",
      "destination": "/ressources/seo-ia/modeles/:path*/index.html"
    },
    {
      "source": "/ressources/seo-ia/:slug",
      "destination": "/ressources/seo-ia/:slug/index.html"
    },
    {
      "source": "/ressources/seo-ia",
      "destination": "/ressources/seo-ia/index.html"
    },
    {
      "source": "/ressources",
      "destination": "/ressources/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/crons/expire-demo-accounts",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://eu-assets.i.posthog.com; worker-src 'self' blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.e-samba.com https://marketing.e-samba.com https://*.supabase.co wss://*.supabase.co https://eu.posthog.com https://eu-assets.i.posthog.com https://*.sentry.io https://*.ingest.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/workbox-:hash.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
