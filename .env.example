# Configuration Supabase
# Copiez ce fichier vers .env.local et remplissez avec vos vraies valeurs

# URL de votre projet Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# ClÃ© publique (anon key) de Supabase
# Cette clÃ© est sÃ»re Ã  exposer cÃ´tÃ© client
VITE_SUPABASE_ANON_KEY=votre_cle_anon_ici

# PostHog (optionnel) — analytics produit (UE par défaut). Sans clé, le suivi est désactivé.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.posthog.com
# VITE_APP_VERSION=0.1.0

# Sentry (optionnel) : DSN pour la capture d'erreurs JS en production
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# URL publique du site (optionnel) : utilisée pour canonical et og:url. Défaut : https://www.e-samba.com
# VITE_APP_URL=https://www.e-samba.com

# Opérations (optionnel) : true = snapshots mockés pour l'écran Opérations
# VITE_OPERATIONS_MOCK=true

# Authentification (optionnel) : true = session locale mockée + redirection garde vers /login
# VITE_USE_MOCK_AUTH=true

# Configuration Firebase (push notifications / FCM - Web)
# Ces valeurs doivent être copiées depuis la console Firebase (projet Web)
VITE_FIREBASE_API_KEY=votre_firebase_api_key_ici
VITE_FIREBASE_AUTH_DOMAIN=votre_firebase_auth_domain_ici
VITE_FIREBASE_PROJECT_ID=votre_firebase_project_id_ici
VITE_FIREBASE_STORAGE_BUCKET=votre_firebase_storage_bucket_ici
VITE_FIREBASE_MESSAGING_SENDER_ID=votre_firebase_messaging_sender_id_ici
VITE_FIREBASE_APP_ID=votre_firebase_app_id_ici
# Clé VAPID publique pour les notifications Web (Web Push)
VITE_FIREBASE_VAPID_KEY=votre_firebase_vapid_key_ici

# --- Edge Functions Supabase (secrets côté projet, pas préfixés VITE_) ---
# Définir sur le projet distant : supabase secrets set KEY=value
# CRON_SECRET=<secret_long_aleatoire>
# FCM_SERVER_KEY=<clé_serveur_FCM_legacy_pour_send-notification_et_retention-nudge>
# RETENTION_IDLE_DAYS=3
# RETENTION_COOLDOWN_DAYS=7
# RETENTION_MAX_PER_RUN=100
#
# Déploiement :
#   supabase functions deploy retention-nudge
#   supabase functions deploy send-notification
#
# Planification : la CLI ne fournit pas `supabase functions schedule` de façon documentée.
# Utiliser le Dashboard Supabase → Integrations → Cron : POST vers
#   https://<project-ref>.supabase.co/functions/v1/retention-nudge
# avec l’en-tête Authorization: Bearer <CRON_SECRET>
# (ex. cron 0 7 * * * = chaque jour à 07:00, fuseau selon le projet).
# Alternative : job SQL pg_cron + pg_net, secrets dans Vault (voir doc Supabase « Scheduling Edge Functions »).
#
# Test local (après `supabase start` et `supabase functions serve --no-verify-jwt`, secrets dans un fichier --env-file) :
#   curl -s -X POST "http://127.0.0.1:54321/functions/v1/retention-nudge" -H "Authorization: Bearer <CRON_SECRET>" -H "Content-Type: application/json"
# Si le CLI signale une erreur de parsing sur `.env.local`, vérifiez l’encodage (UTF-8 sans BOM).

