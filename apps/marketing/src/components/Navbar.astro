---
import { APP_SITE_URL } from "@/lib/site";

const nav = [
  { label: "Guides", href: "/guides" },
  { label: "Solutions", href: "/solutions" },
  { label: "Fonctionnalités", href: "/fonctionnalites" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 glass-dark">
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="/guides" class="flex items-center gap-2 font-heading font-bold text-lg">
      <span
        class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-primary-foreground"
        aria-hidden="true">⚡</span>
      E-Samba
    </a>
    <nav class="hidden md:flex items-center gap-6" aria-label="Navigation principale">
      {
        nav.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-3">
      <a
        href={`${APP_SITE_URL}/auth`}
        class="hidden sm:inline text-sm text-muted-foreground hover:text-primary"
      >
        Connexion
      </a>
      <a
        href={`${APP_SITE_URL}/auth?mode=signup`}
        class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90"
      >
        Démarrer
      </a>
    </div>
  </div>
</header>
