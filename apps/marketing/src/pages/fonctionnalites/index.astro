---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedFeatures, featurePath } from "@/lib/content";

const features = await getPublishedFeatures();
---

<BaseLayout
  title="Fonctionnalités E-Samba"
  description="Samba-Fuel, rapports multi-flottes, alertes, maintenance Samba-Care et score conducteur pour votre flotte."
  canonicalPath="/fonctionnalites"
>
  <div class="container mx-auto px-4 max-w-4xl">
    <header class="mb-12 text-center">
      <h1 class="font-heading text-4xl font-bold mb-4">Fonctionnalités</h1>
      <p class="text-muted-foreground text-lg">
        Modules conçus pour le terrain en Afrique centrale.
      </p>
    </header>
    <ul class="grid gap-6 md:grid-cols-2">
      {
        features.map((f) => (
          <li>
            <a
              href={featurePath(f.slug)}
              class="block h-full rounded-2xl border border-border bg-card p-6 hover:border-primary/40 transition-colors"
            >
              {f.data.module && (
                <span class="text-xs font-semibold text-accent uppercase tracking-wider">
                  {f.data.module}
                </span>
              )}
              <h2 class="font-heading text-xl font-bold mt-2 mb-2">
                {f.data.title}
              </h2>
              <p class="text-sm text-muted-foreground">{f.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
