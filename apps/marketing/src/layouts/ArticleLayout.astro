---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CtaSignup from "@/components/CtaSignup.astro";
import type { Crumb } from "@/components/Breadcrumb.astro";
import { MARKETING_SITE_URL } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  pubDate: Date;
  breadcrumbs: Crumb[];
  relatedLinks?: { href: string; label: string }[];
}

const {
  title,
  description,
  canonicalPath,
  pubDate,
  breadcrumbs,
  relatedLinks = [],
} = Astro.props;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  publisher: {
    "@type": "Organization",
    name: "E-Samba",
    url: MARKETING_SITE_URL,
  },
  mainEntityOfPage: new URL(canonicalPath, MARKETING_SITE_URL).href,
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  type="article"
  pubDate={pubDate}
  jsonLd={articleJsonLd}
>
  <article class="container mx-auto px-4 max-w-3xl">
    <Breadcrumb items={breadcrumbs} />
    <header class="mb-8">
      <time
        datetime={pubDate.toISOString()}
        class="text-xs text-muted-foreground uppercase tracking-wider"
      >
        {pubDate.toLocaleDateString("fr-FR", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mt-2 mb-4">
        {title}
      </h1>
      <p class="text-muted-foreground text-lg">{description}</p>
    </header>
    <div class="prose-esamba">
      <slot />
    </div>
    {
      relatedLinks.length > 0 && (
        <aside class="mt-12 pt-8 border-t border-border">
          <h2 class="font-heading font-semibold text-lg mb-4">À lire aussi</h2>
          <ul class="space-y-2">
            {relatedLinks.map((link) => (
              <li>
                <a href={link.href} class="text-primary hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
    <div class="mt-12 p-8 rounded-2xl border border-border bg-card text-center">
      <h2 class="font-heading text-xl font-bold mb-2">
        Pilotez votre flotte avec E-Samba
      </h2>
      <p class="text-muted-foreground text-sm mb-6 max-w-md mx-auto">
        Essai gratuit — véhicules, carburant, maintenance et clôtures terrain en un seul tableau de bord.
      </p>
      <CtaSignup />
    </div>
  </article>
</BaseLayout>
