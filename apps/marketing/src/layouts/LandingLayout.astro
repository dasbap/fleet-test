---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CtaSignup from "@/components/CtaSignup.astro";
import type { Crumb } from "@/components/Breadcrumb.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  breadcrumbs: Crumb[];
  heroLabel?: string;
}

const { title, description, canonicalPath, breadcrumbs, heroLabel } =
  Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <div class="container mx-auto px-4 max-w-4xl">
    <Breadcrumb items={breadcrumbs} />
    <header class="mb-12 text-center max-w-2xl mx-auto">
      {
        heroLabel && (
          <p class="text-primary text-sm font-semibold uppercase tracking-wider mb-3">
            {heroLabel}
          </p>
        )
      }
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4">
        {title}
      </h1>
      <p class="text-muted-foreground text-lg mb-8">{description}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <CtaSignup />
        <CtaSignup label="Voir une démo" variant="outline" />
      </div>
    </header>
    <div class="prose-esamba max-w-3xl mx-auto">
      <slot />
    </div>
  </div>
</BaseLayout>
