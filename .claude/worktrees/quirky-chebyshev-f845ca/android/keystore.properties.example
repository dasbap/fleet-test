# Copier ce fichier vers keystore.properties (non versionné) et renseigner les valeurs.
# Ne jamais committer keystore.properties ni upload-keystore.jks (voir .gitignore).
# Conserver une copie du .jks et des mots de passe dans un coffre-fort d'équipe : sans eux,
# impossible de publier des mises à jour Play signées avec la même clé.
#
# Génération d’un keystore (exemple) :
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Chemins : ce fichier est lu depuis le répertoire android/. La propriété storeFile est résolue
# depuis android/app/ (module Gradle), d’où le préfixe ../ pour un fichier dans android/.

storePassword=changeme
keyPassword=changeme
keyAlias=upload
storeFile=../upload-keystore.jks
