{
  "name": "smart-fleet-africa",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/db"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "npx prisma generate --schema packages/db/prisma/schema.prisma && node scripts/install-playwright.mjs && patch-package",
    "dev": "vite",
    "marketing:dev": "npm --prefix apps/marketing run dev",
    "marketing:build": "npm --prefix apps/marketing run build",
    "marketing:deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-marketing-vercel.ps1",
    "dev:api": "tsx watch --env-file=.env.local --tsconfig tsconfig.server.json src/server/index.ts",
    "dev:local": "node scripts/dev-with-open.mjs",
    "open:local": "node scripts/open-local-browser.mjs",
    "open:local:strict": "cross-env SMOKE_STRICT=1 node scripts/open-local-browser.mjs",
    "smoke:dev-local": "node scripts/open-local-browser.mjs && node scripts/dev-network-check.mjs",
    "smoke:dev-local:ci": "node scripts/open-local-browser.mjs --no-open && node scripts/dev-network-check.mjs",
    "smoke:dev-local:all": "node scripts/open-local-browser.mjs && cross-env SMOKE_BROWSERS=all node scripts/dev-network-check.mjs",
