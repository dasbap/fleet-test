{
  "name": "smart-fleet-africa",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:capacitor": "vite build --mode capacitor",
    "build:dev": "vite build --mode development",
    "check:vite-external": "node scripts/check-vite-external.mjs",
    "cap:doctor": "node scripts/capacitor-doctor.mjs",
    "cap:cli": "npx -y node@22 node_modules/@capacitor/cli/bin/capacitor",
    "cap:sync": "npm run cap:doctor && npm run cap:cli -- sync",
    "cap:copy": "npm run cap:doctor && npm run cap:cli -- copy",
    "mobile:prepare": "npm run build:capacitor && npm run cap:sync",
    "mobile:sync-version": "node scripts/sync-mobile-version.mjs",
    "setup:android-keystore": "powershell -ExecutionPolicy Bypass -File scripts/setup-android-keystore.ps1",
    "secrets:github-android": "node scripts/push-github-android-secrets.mjs",
    "cap:open:android": "npm run cap:doctor && npm run cap:cli -- open android",
    "cap:open:ios": "npm run cap:doctor && npm run cap:cli -- open ios",
    "cap:assets": "node scripts/capacitor-assets.mjs",
    "store:screenshots": "node scripts/generate-store-screenshots.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "validate:production": "vite build && vite preview",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-cursor.ps1",
    "check:extensions": "powershell -ExecutionPolicy Bypass -File scripts/check-extensions.ps1",
    "init:env": "powershell -ExecutionPolicy Bypass -File scripts/init-env.ps1",
    "check:supabase": "powershell -ExecutionPolicy Bypass -File scripts/check-supabase.ps1",
    "verify:connection": "node scripts/verify-connection.js",
    "verify:supabase": "node scripts/verify-supabase-health.js",
    "check:backend": "powershell -ExecutionPolicy Bypass -File scripts/check-backend.ps1",
    "verify:migration": "powershell -ExecutionPolicy Bypass -File scripts/verify-migration-status.ps1",
    "install:supabase-cli": "powershell -ExecutionPolicy Bypass -File scripts/install-supabase-cli.ps1",
    "verify:supabase-link": "powershell -ExecutionPolicy Bypass -File scripts/verify-supabase-link.ps1",
    "supabase": "supabase",
    "cleanup:db": "node scripts/run-cleanup-db.js",
    "cleanup:db:cli": "powershell -ExecutionPolicy Bypass -File scripts/run-cleanup-via-cli.ps1",
    "test:migrations": "powershell -ExecutionPolicy Bypass -File scripts/test-migrations.ps1",
    "hero:images": "node scripts/generate-hero-images.js",
    "freeze:remote-schema": "powershell -ExecutionPolicy Bypass -File scripts/freeze-remote-schema.ps1",
    "test:baseline-delta": "powershell -ExecutionPolicy Bypass -File scripts/test-baseline-delta.ps1",
    "test:sql-security": "powershell -ExecutionPolicy Bypass -File scripts/test-sql-security.ps1",
    "diagnostic:e-samba": "node scripts/diagnostic-e-samba-console.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^10.38.0",
    "@supabase/supabase-js": "^2.93.3",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.11.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "web-vitals": "^5.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "pg": "^8.18.0",
    "playwright": "^1.51.0",
    "postcss": "^8.5.6",
    "sharp": "^0.33.5",
    "supabase": "^2.84.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
