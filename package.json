    "deploy:prebuilt": "npm run build && npm run vercel:package-prebuilt && npx vercel deploy --prebuilt --prod --yes",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "seo:use-cases": "node scripts/generate-use-case-seo.mjs",
    "seo:use-cases:fetch": "node scripts/generate-use-case-seo.mjs --fetch",
