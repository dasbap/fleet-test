{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/dashboard",
        "http://localhost:4173/dashboard/vehicles",
        "http://localhost:4173/dashboard/drivers",
        "http://localhost:4173/dashboard/maintenance",
        "http://localhost:4173/dashboard/fuel",
        "http://localhost:4173/dashboard/billing",
        "http://localhost:4173/dashboard/alerts",
        "http://localhost:4173/dashboard/tutorials"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless --disable-gpu --disable-dev-shm-usage",
        "maxWaitForLoad": 60000,
        "throttlingMethod": "devtools",
        "throttling": {
          "rttMs": 300,
          "throughputKbps": 1600,
          "uploadThroughputKbps": 768,
          "cpuSlowdownMultiplier": 4
        },
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "onlyCategories": ["performance", "accessibility"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:accessibility": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }]
      }
    }
  }
}
