{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/login",
        "http://localhost:4173/auth"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        },
        "screenEmulation": {
          "mobile": false,
          "width": 1440,
          "height": 900,
          "deviceScaleFactor": 1
        },
        "onlyCategories": ["performance", "accessibility"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.75,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.85,
            "aggregationMethod": "median"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median"
          }
        ],
        "interaction-to-next-paint": [
          "warn",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median"
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2800,
            "aggregationMethod": "median"
          }
        ],
        "speed-index": [
          "warn",
          {
            "maxNumericValue": 4500,
            "aggregationMethod": "median"
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 450,
            "aggregationMethod": "median"
          }
        ],
        "uses-webp-images": ["warn", { "maxLength": 12 }],
        "uses-optimized-images": ["warn", { "maxLength": 12 }],
        "render-blocking-resources": ["warn", { "maxLength": 10 }],
        "font-display": ["warn", { "maxLength": 5 }],
        "uses-rel-preconnect": ["warn", { "maxLength": 5 }],
        "unused-javascript": [
          "warn",
          {
            "maxNumericValue": 393216,
            "aggregationMethod": "median"
          }
        ],
        "unused-css-rules": [
          "warn",
          {
            "maxNumericValue": 153600,
            "aggregationMethod": "median"
          }
        ]
      }
    }
  }
}
